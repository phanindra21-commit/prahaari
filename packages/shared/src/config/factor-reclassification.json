      "historicalIncidentDensity": { "direction": "DIRECT", "unit": "index0to1", "breakpoints": [{ "max": 0.2, "rating": 1 }, { "max": 0.4, "rating": 2 }, { "max": 0.6, "rating": 3 }, { "max": 0.8, "rating": 4 }, { "max": null, "rating": 5 }] },
