# PunarVas API — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/punarvas

# Auth — JWT access/refresh secrets. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access and refresh MUST use different secrets so a leaked access-token
# signing key cannot be used to mint refresh tokens, or vice versa.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-16-chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated allowlist of origins the web app is served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Refresh-token cookie. COOKIE_SECURE is forced true automatically when
# NODE_ENV=production regardless of this value; set true here too if you
# want to test HTTPS-only cookie behaviour locally over HTTPS.
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Dev-only seed user password (apps/api/src/scripts/seed.ts). Never used
# outside the seed script; never a real secret. Override for your own
# local demo if you like, but this default is fine and is not sensitive.
# Every seeded user gets this password unless a per-role override is set,
# e.g. SEED_PASSWORD_SUPER_ADMIN=SomethingElse123 (role names match
# packages/shared USER_ROLES exactly: SUPER_ADMIN, STATE_ADMIN,
# DISTRICT_OFFICER, ANALYST, FIELD_VOLUNTEER).
SEED_DEFAULT_PASSWORD=PunarVas@DevDefault123

# ML service (services/ml)
ML_SERVICE_URL=http://localhost:8000
